{
  "expo": {
    "name": "Lacrosse Faceoff Trainer",
    "slug": "lacrosse-faceoff-trainer",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jljackson222.lacrossefaceofftrainer",
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.marshellis.laxfaceoff",
      "permissions": ["RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/3655c7ed-55eb-4d91-904b-e1cdb3b9ba54"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "3655c7ed-55eb-4d91-904b-e1cdb3b9ba54"
      }
    },
    "owner": "marshellis",
    "scheme": "laxfaceoff",
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-vector-icons/ionicons",
      "react-native-audio-api",
      "expo-status-bar",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "Lacrosse Faceoff Trainer uses the microphone only when you record your own custom whistle or call cues."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
