{
  "name": "lacrossefaceoffapp",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "publish:doctor": "bash scripts/publish/doctor.sh",
    "build:dev": "npx eas-cli build --profile development",
    "build:preview": "npx eas-cli build --profile preview",
    "build:prod": "npx eas-cli build --profile production",
    "submit:ios": "npx eas-cli submit --profile production --platform ios",
    "submit:android": "npx eas-cli submit --profile production --platform android",
    "ota": "npx eas-cli update"
  },
  "dependencies": {
    "@react-native-community/slider": "5.2.1",
    "@react-native-vector-icons/ionicons": "^14.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.20",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-audio-api": "^0.13.6",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "^2.6.4",
    "@expo/config-plugins": "~58.0.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
